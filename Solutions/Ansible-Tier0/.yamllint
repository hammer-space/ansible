---
extends: default

rules:
  line-length:
    max: 200
    level: warning
  indentation:
    spaces: 2
    indent-sequences: true
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 0
  octal-values:
    forbid-implicit-octal: true
