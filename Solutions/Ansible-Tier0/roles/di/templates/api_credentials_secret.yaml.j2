---
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ di_k8s_api_credentials_secret }}
  namespace: {{ di_k8s_namespace }}
  labels:
    app.kubernetes.io/name: hammerspace-di
    app.kubernetes.io/managed-by: ansible-tier0
stringData:
  HAMMERSPACE_API_USER: {{ hammerspace_api_user | string }}
  HAMMERSPACE_API_PASSWORD: {{ hammerspace_api_password | string }}
  HAMMERSPACE_API_HOST: {{ (hammerspace_cluster_mgmt_ip | default(hammerspace_api_host)) | string }}
  HAMMERSPACE_API_PORT: "{{ hammerspace_api_port | default(8443) }}"
  HAMMERSPACE_CLUSTER_HOSTNAME: {{ hammerspace_cluster_hostname | default('data-cluster') | string }}
  DI_NODE_NETMASK_PREFIX: "{{ di_node_netmask_prefix | default(24) }}"
  DI_IGNORE_IP_CONFLICTS: "{{ (di_ignore_ip_conflicts | default(true)) | string | lower }}"
